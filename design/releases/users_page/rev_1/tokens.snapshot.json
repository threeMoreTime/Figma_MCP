{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "metadata": {
    "name": "Canonical Design Tokens",
    "dataSource": "CANONICAL_SYNTHETIC",
    "description": "Deterministic base tokens adapting to Ant Design 5.7.3 and CSS variables.",
    "version": "1.0.0"
  },
  "color": {
    "brand": {
      "blue": {
        "600": {
          "$value": "#1677ff",
          "$type": "color"
        },
        "700": {
          "$value": "#0958d9",
          "$type": "color"
        }
      },
      "green": {
        "500": {
          "$value": "#52c41a",
          "$type": "color"
        }
      },
      "red": {
        "500": {
          "$value": "#ff4d4f",
          "$type": "color"
        }
      }
    },
    "neutral": {
      "white": {
        "$value": "#ffffff",
        "$type": "color"
      },
      "gray": {
        "100": {
          "$value": "#f5f5f5",
          "$type": "color"
        },
        "300": {
          "$value": "#d9d9d9",
          "$type": "color"
        },
        "700": {
          "$value": "#595959",
          "$type": "color"
        },
        "900": {
          "$value": "#141414",
          "$type": "color"
        }
      }
    },
    "primary": {
      "$value": "{color.brand.blue.600}",
      "$type": "color"
    },
    "success": {
      "$value": "{color.brand.green.500}",
      "$type": "color"
    },
    "error": {
      "$value": "{color.brand.red.500}",
      "$type": "color"
    },
    "bg": {
      "container": {
        "$value": "{color.neutral.white}",
        "$type": "color"
      },
      "layout": {
        "$value": "{color.neutral.gray.100}",
        "$type": "color"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.neutral.gray.900}",
        "$type": "color"
      },
      "secondary": {
        "$value": "{color.neutral.gray.700}",
        "$type": "color"
      }
    },
    "border": {
      "$value": "{color.neutral.gray.300}",
      "$type": "color"
    }
  },
  "spacing": {
    "xs": {
      "$value": 4,
      "$type": "dimension"
    },
    "sm": {
      "$value": 8,
      "$type": "dimension"
    },
    "md": {
      "$value": 16,
      "$type": "dimension"
    },
    "lg": {
      "$value": 24,
      "$type": "dimension"
    }
  },
  "borderRadius": {
    "sm": {
      "$value": 2,
      "$type": "dimension"
    },
    "base": {
      "$value": 6,
      "$type": "dimension"
    },
    "lg": {
      "$value": 8,
      "$type": "dimension"
    }
  },
  "fontSize": {
    "base": {
      "$value": 14,
      "$type": "dimension"
    },
    "lg": {
      "$value": 16,
      "$type": "dimension"
    },
    "heading": {
      "$value": 20,
      "$type": "dimension"
    }
  }
}